{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npm --prefix server install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
